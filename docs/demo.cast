[0.897642, "o", "\u001b[38;2;118;118;118m\u001b[48;2;28;28;28m* mqsc-lsp demo - each inline message is a live server diagnostic.\r\n\u001b[38;2;88;88;88m-\u001b[38;2;255;0;0mE \u001b[38;2;88;88;88m  2 \u001b[38;2;175;135;175mDEFINE\u001b[38;2;188;188;188m \u001b[38;2;95;135;175mQLOCAL\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135mORDERS.IN\u001b[38;2;188;188;188m) \u001b[38;2;135;175;175m\u001b[4mMAXMSGS\u001b(B\u001b[m\u001b[38;2;188;188;188m\u001b[48;2;28;28;28m(\u001b[38;2;215;95;135m10\u001b[38;2;188;188;188m) +     \u001b[38;2;255;0;0m>> 'MAXMSGS' is not a parameter of DEFINE QLOCAL — did you m\u001b[3;1H\u001b[38;2;88;88;88m│\u001b[38;2;188;188;188m  \u001b[38;2;88;88;88m  3 \u001b[38;2;188;188;188m             \u001b[38;2;135;175;175mDESCR\u001b[38;2;188;188;188m(\u001b[38;2;95;175;95m'Order feed queue'\u001b[4;8H\u001b[38;2;175;135;175mDEFINE\u001b[38;2;188;188;188m \u001b[38;2;95;135;175mQLOCAL\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135mBACKOUT.QUEUE\u001b[38;2;188;188;188m) \u001b[38;2;135;175;175mLIKE\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135mORDERS.IN\u001b[38;2;188;188;188m) \u001b[38;2;135;175;175mREPLACE\u001b[5;8H\u001b[38;2;175;135;175mDEFINE\u001b[38;2;188;188;188m \u001b[38;2;95;135;175mQALIAS\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135mSHOP.FRONT\u001b[38;2;188;188;188m) \u001b[38;2;135;175;175mTARGET\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135mORDERS.IN\u001b[6;2H\u001b[38;2;211;211;211mH \u001b[38;2;88;88;88m  6 \u001b[38;2;175;135;175mDEFINE\u001b[38;2;188;188;188m \u001b[38;2;95;135;175mQALIAS\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135mSHOP.BACK\u001b[38;2;188;188;188m) \u001b[38;2;135;175;175mTARGET\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135m\u001b[4mNO.SUCH.QUEUE\u001b(B\u001b[m\u001b[38;2;188;188;188m\u001b[48;2;28;28;28m)     \u001b[38;2;211;211;211m>> 'NO.SUCH.QUEUE' is not DEFINEd in this script; it\u001b[7;2H\u001b[38;2;255;165;0mW \u001b[38;2;88;88;88m  7 \u001b[38;2;175;135;175mDEFINE\u001b[38;2;188;188;188m \u001b[38;2;95;135;175mQLOCAL\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135m\u001b[4mA.QUEUE.WHOSE.NAME.SPANS.MORE.CHARACTERS.THAN.MQ.ALLOWS\u001b(B\u001b[m\u001b[38;2;188;188;188m\u001b[48;2;28;28;28m) \u001b[38;2;135;175;175mREPLACE\u001b[38;2;188;188;188m     \u001b[38;2;255;165;0m>> A QLOCAL name hol\u001b[8;2HW \u001b[38;2;88;88;88m  8 \u001b[38;2;175;135;175mDEFINE\u001b[38;2;188;188;188m \u001b[38;2;95;135;175mQLOCAL\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135mTAB.QUEUE\u001b[38;2;188;188;188m)\u001b[4m        \u001b(B\u001b[m\u001b[38;2;135;175;175m\u001b[48;2;28;28;28mREPLACE\u001b[38;2;188;188;188m     \u001b[38;2;255;165;0m>> MQSC does not treat a tab as whitespace — this character\u001b[9;8H\u001b[38;2;175;135;175mDEFINE\u001b[38;2;188;188;188m \u001b[38;2;95;135;175mQLOCAL\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135mORDERS.OUT\u001b[10;2H\u001b[38;2;255;0;0mE \u001b[38;2;88;88;88m 10 \u001b[38;2;188;188;188m    \u001b[?25l\u001b(B\u001b[m\u001b[38;2;175;135;175m\u001b[48;2;28;28;28m\u001b[4mDESCR\u001b(B\u001b[m\u001b[38;2;188;188;188m\u001b[48;2;28;28;28m \u001b[38;2;95;135;175mREPLACE\u001b[38;2;188;188;188m     \u001b[38;2;255;0;0m>> 'REPLACE' is not a command; it is a parameter. If this line continues the comm\u001b[11;2HE \u001b[38;2;88;88;88m 11 \u001b[38;2;175;135;175mALTER\u001b[38;2;188;188;188m \u001b[38;2;95;135;175mQLOCAL\u001b[38;2;188;188;188m(\u001b[38;2;215;95;135mORDERS.IN\u001b[38;2;188;188;188m) \u001b[38;2;135;175;175mDESCR\u001b[38;2;188;188;188m(\u001b[38;2;95;175;95m'the script ends on a dangling continuation'\u001b[38;2;188;188;188m) \u001b[4m-\u001b(B\u001b[m\u001b[38;2;188;188;188m\u001b[48;2;28;28;28m     \u001b[38;2;255;0;0m>> '-' continuation m\u001b[1;8H\u001b[?12l\u001b[?25h\u001b[2 q\u001b(B\u001b[m"]
