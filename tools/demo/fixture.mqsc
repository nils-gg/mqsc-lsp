* mqsc-lsp demo - each inline message is a live server diagnostic.
DEFINE QLOCAL(ORDERS.IN) MAXMSGS(10) +
             DESCR('Order feed queue')
DEFINE QLOCAL(BACKOUT.QUEUE) LIKE(ORDERS.IN) REPLACE
DEFINE QALIAS(SHOP.FRONT) TARGET(ORDERS.IN)
DEFINE QALIAS(SHOP.BACK) TARGET(NO.SUCH.QUEUE)
DEFINE QLOCAL(A.QUEUE.WHOSE.NAME.SPANS.MORE.CHARACTERS.THAN.MQ.ALLOWS) REPLACE
DEFINE QLOCAL(TAB.QUEUE)	REPLACE
DEFINE QLOCAL(ORDERS.OUT)
    DESCR REPLACE
ALTER QLOCAL(ORDERS.IN) DESCR('the script ends on a dangling continuation') -
