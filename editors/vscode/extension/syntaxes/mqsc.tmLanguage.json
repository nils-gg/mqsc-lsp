{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MQSC",
  "scopeName": "source.mqsc",
  "patterns": [
    {
      "name": "comment.line.mqsc",
      "match": "^\\*.*$"
    },
    {
      "name": "string.quoted.single.mqsc",
      "begin": "'",
      "end": "'(?!')",
      "patterns": [
        {
          "name": "constant.character.escape.mqsc",
          "match": "''"
        }
      ]
    },
    {
      "name": "keyword.language.mqsc",
      "match": "(?i)\\b(?:DEFINE|DEF|ALTER|ALT|DISPLAY|DIS|DELETE|DEL|CLEAR|CLR|ADD|SET|MOVE|PING|REFRESH|RESOLVE|RECOVER|ARCHIVE|BACKUP|RVERIFY|START|STOP|SUSPEND|RESUME|RESET)\\b"
    },
    {
      "name": "support.type.object.mqsc",
      "match": "(?i)\\b(?:ARCHIVE|AUTHINFO|BSDS|BUFFPOOL|CFSTATUS|CFSTRUCT|CHANNEL|CHL|CHINIT|CHSTATUS|CLUSQMGR|CLUSTER|CMDSERV|CONN|GROUP|GRP|INDOUBT|LISTENER|LSTR|LOG|LSSTATUS|MAXSMSGS|NAMELIST|PROCESS|PROC|PSID|PUBSUB|QALIAS|QA|QLOCAL|QL|QMGR|QM|QMODEL|QSTATUS|QSTATS|QREMOTE|QR|QUEUE|SBSTATUS|SECURITY|SERVICE|SVC|STGCLASS|SUB|SVSTATUS|SYSTEM|THREAD|TOPIC|TOP|TOPICSTR|TRACE|TPIPE|TPSTATUS|USAGE|CCWLM|CLNTCONN|COMMUNITY|PRINCIPAL|SBF)\\b"
    },
    {
      "name": "constant.numeric.mqsc",
      "match": "\\b[0-9]+\\b"
    },
    {
      "name": "keyword.operator.continuation.mqsc",
      "match": "(?:^|(?<=\\s))[-+]\\s*$|(?<=\\S)\\+\\s*$"
    },
    {
      "name": "variable.parameter.mqsc",
      "match": "(?i)\\b[A-Z][A-Z0-9_#$@%/.-]*\\b(?=\\s*\\()"
    }
  ]
}
